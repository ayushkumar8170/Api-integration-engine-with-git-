{
  "info": {
    "name": "Automated REST API & System Integration Engine",
    "description": "Manual/CI (newman) verification of the payload ingest endpoint: schema validation, authorization, latency-budget enforcement, and bridge-target resolution.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiKey", "value": "local-dev-key" }
  ],
  "item": [
    {
      "name": "Health check (no auth required)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/payloads/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('body reports healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - valid payload succeeds",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "url": "{{baseUrl}}/api/payloads/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"orders-service\",\n  \"schemaId\": \"payload.schema.json\",\n  \"payload\": {\n    \"orderId\": \"ORD-1029\",\n    \"amount\": 42.50,\n    \"currency\": \"USD\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response reports bridged', () => pm.expect(pm.response.json().status).to.eql('bridged'));",
              "pm.test('response time is within latency budget', () => pm.expect(pm.response.responseTime).to.be.below(130));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - missing required field returns 400",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "url": "{{baseUrl}}/api/payloads/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"orders-service\",\n  \"schemaId\": \"payload.schema.json\",\n  \"payload\": {\n    \"orderId\": \"ORD-1029\",\n    \"currency\": \"USD\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('error is schema_validation_failed', () => pm.expect(pm.response.json().error).to.eql('schema_validation_failed'));",
              "pm.test('details array is non-empty', () => pm.expect(pm.response.json().details.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - invalid currency format returns 400",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "url": "{{baseUrl}}/api/payloads/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"orders-service\",\n  \"schemaId\": \"payload.schema.json\",\n  \"payload\": {\n    \"orderId\": \"ORD-1029\",\n    \"amount\": 10,\n    \"currency\": \"us-dollars\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - unknown bridge target returns 404",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "url": "{{baseUrl}}/api/payloads/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"does-not-exist\",\n  \"schemaId\": \"payload.schema.json\",\n  \"payload\": {\n    \"orderId\": \"ORD-1029\",\n    \"amount\": 10,\n    \"currency\": \"USD\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('error is unknown_bridge_target', () => pm.expect(pm.response.json().error).to.eql('unknown_bridge_target'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - missing API key returns 401",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/payloads/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"orders-service\",\n  \"schemaId\": \"payload.schema.json\",\n  \"payload\": {\n    \"orderId\": \"ORD-1029\",\n    \"amount\": 10,\n    \"currency\": \"USD\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));",
              "pm.test('error is unauthorized', () => pm.expect(pm.response.json().error).to.eql('unauthorized'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest - downstream delay exceeding budget returns 504",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Api-Key", "value": "{{apiKey}}" },
          { "key": "X-Inject-Delay-Ms", "value": "300" }
        ],
        "url": "{{baseUrl}}/api/payloads/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"orders-service\",\n  \"schemaId\": \"payload.schema.json\",\n  \"payload\": {\n    \"orderId\": \"ORD-1029\",\n    \"amount\": 10,\n    \"currency\": \"USD\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 504', () => pm.response.to.have.status(504));",
              "pm.test('error is latency_budget_exceeded', () => pm.expect(pm.response.json().error).to.eql('latency_budget_exceeded'));"
            ]
          }
        }
      ]
    }
  ]
}
